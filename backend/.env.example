# Copy this file to .env and fill in real values. Never commit .env.
TRUSTTRACE_DATABASE_URL=sqlite:///./data/trusttrace.db
TRUSTTRACE_ENV=development

# Reserved for future use. HTTP adapter secrets are NOT stored here or in
# the database -- an integration's config only names an environment
# variable (auth.secret_env_var) that's resolved at request time; set that
# variable's actual value directly in your own shell/.env, under whatever
# name you chose.
TRUSTTRACE_SECRET_KEY=dev-only-insecure-key-change-me

# Optional: enables the LLM judge evaluator (app/evaluators/llm_judge.py)
# for free-text test cases that opt in via evaluator_config["llm_judge"].
# Left unset, that evaluator reports "unavailable" and TrustTrace runs
# fully on its 8 deterministic evaluators -- no key is ever required for
# the free local demo.
# ANTHROPIC_API_KEY=

# Optional: enables OCR fallback for scanned/image-based PDF document
# fixtures (app/services/ocr_service.py). Without this, a PDF upload that
# yields little native text is still accepted but reported with
# extraction_status="partial" and an explicit note -- never silently
# treated as successfully read. See docs/ocr.md.
# MISTRAL_API_KEY=
