# Copy this file to .env and fill in real values. Never commit .env.
TRUSTTRACE_DATABASE_URL=sqlite:///./data/trusttrace.db
TRUSTTRACE_ENV=development

# Secrets for HTTP integrations are stored per-integration via the secrets
# store (see app/secrets.py), not as plaintext columns. This key encrypts
# that local secret store at rest. Generate your own for any non-demo use:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRUSTTRACE_SECRET_KEY=dev-only-insecure-key-change-me

# Optional: only needed if you later enable the LLM-as-judge evaluator.
# Left unset, TrustTrace runs fully on deterministic evaluators.
# ANTHROPIC_API_KEY=
